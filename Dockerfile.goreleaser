# Used exclusively by goreleaser (dockerfile: in .goreleaser.yaml).
# Its isolated context holds binaries under <os>/<arch>/..., exposed
# here as $TARGETPLATFORM.
#
# Base is scratch so every target platform resolves - distroless ships
# no i386 image. storhub talks TLS to api.github.com, so CA
# certificates come from the Go toolchain image pinned to BUILDPLATFORM
# (the files are identical across platforms; only one pull happens).
# The numeric USER matches distroless' nonroot UID without needing an
# /etc/passwd, which scratch does not have.
FROM --platform=$BUILDPLATFORM golang:1.26.7-alpine AS ca
RUN apk add --no-cache ca-certificates

FROM scratch
ARG TARGETPLATFORM
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY $TARGETPLATFORM/storhub /usr/bin/storhub
USER 65532:65532
ENTRYPOINT ["/usr/bin/storhub"]
